#!/usr/bin/env sh
set -eu
VERSION=8.9
BASE="${GRADLE_USER_HOME:-$HOME/.gradle}/local-distributions"
INSTALL="$BASE/gradle-$VERSION"
EXE="$INSTALL/gradle-$VERSION/bin/gradle"
if [ ! -x "$EXE" ]; then
  mkdir -p "$BASE"
  ZIP="$BASE/gradle-$VERSION-bin.zip"
  echo "Gradle $VERSION is missing. Downloading Gradle (one-time setup)..."
  if command -v curl >/dev/null 2>&1; then curl -fL "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip" -o "$ZIP"
  else wget -O "$ZIP" "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip"; fi
  mkdir -p "$INSTALL"
  unzip -oq "$ZIP" -d "$INSTALL"
fi
exec "$EXE" "$@"
